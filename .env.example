# Copy this file to .env and fill in real values. Never commit the real .env.
GROQ_API_KEY=your_groq_api_key_here
DJANGO_SECRET_KEY=replace_with_a_random_secret
DEBUG=False
ALLOWED_HOSTS=your-backend-domain.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Base URL of the Django backend API (no trailing slash).
# Only used by MilleBot, the AI chatbot — auth and project requests now
# go straight to Supabase.
VITE_API_BASE_URL=http://localhost:8000/api
