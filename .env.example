# Copy this file to .env and fill in real values. Never commit the real .env.
# Frontend (Vite) only. These are also what you set as Environment Variables
# on Vercel (Project → Settings → Environment Variables) for the production
# build.

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Base URL of the Django backend API (no trailing slash).
# Only used by MilleBot, the AI chatbot — auth and project requests go
# straight to Supabase. On Vercel, set this to your Render backend URL,
# e.g. https://millenium-tech-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Optional overrides — safe to leave unset, code already has a working
# default for both.
# VITE_FORMSPREE_ID=xkokypwg
# VITE_SITE_URL=https://millenium-tech-ucqa.vercel.app
