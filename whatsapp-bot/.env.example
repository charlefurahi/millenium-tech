# Copy this file to .env and fill in real values. Never commit the real .env.
DJANGO_API_URL=http://127.0.0.1:8000/api/whatsapp/message/
BOT_TOKEN=your_shared_whatsapp_bot_token_here
ONLY_PRIVATE_CHATS=true

# Optional overrides — safe to leave unset, index.js already has a working
# default for each.
# WA_PAIRING_NUMBER=255700000000
# AUTO_RESET_ON_LOGOUT=true
# MAX_MSGS_PER_MINUTE=12
